{
  "name": "mysawari-backend",
  "version": "3.0.0",
  "private": true,
  "description": "MySawari intelligent ride matching and dynamic driver allocation backend",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "db:check": "node scripts/check-migrations.js",
    "verify": "npm run check && npm run db:check && npm test",
    "start:worker": "node src/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.6.7"
  }
}
