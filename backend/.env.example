# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Supabase: create a project, then copy values from Project Settings > API.
# The anon/publishable key is used for authenticated user-scoped requests.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for trusted ride creation and background dispatch. SERVER ONLY; NEVER expose to Vite.
SUPABASE_SERVICE_ROLE_KEY=

# Automatic captain dispatch
DISPATCH_ENABLED=true
DISPATCH_INTERVAL_MS=10000
CAPTAIN_OFFER_TIMEOUT_SECONDS=35
POOL_WAIT_SECONDS=60

# Routing and geocoding
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MySawari/2.1 (contact: replace-with-your-email@example.com)

# NVIDIA AI assistant (optional; assistant returns a clear unavailable response without it)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Demo pricing in INR
FARE_BIKE_BASE=25
FARE_SCOOTER_BASE=30
FARE_CAR_BASE=60
FARE_PER_KM=9
SURGE_CAP=1.5
LOCATION_STALE_SECONDS=90
